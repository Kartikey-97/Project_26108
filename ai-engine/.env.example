# ai-engine environment configuration
# Copy to `.env` and fill in real values. `.env` is gitignored.

# --- Gemini / Google Generative AI ---
# Primary API key. The engine also accepts AI_ENGINE_GEMINI_KEY, GEMINI_API_KEY,
# or GOOGLE_API_KEY_2 (checked in that order) for backwards compatibility.
GOOGLE_API_KEY=your-gemini-api-key-here

# Model name. Override only if Google changes model availability — verify the
# new name against `client.models.list()` before editing.
GEMINI_MODEL=gemini-3.6-flash

# Reasoning mode for the /analyze endpoint: "gemini" (default) or "mock".
AI_MODE=gemini
